# =========================================================================
# 3-Tier Report Generator .gitignore
# =========================================================================

# -------------------------------------------------------------------------
# Node / Frontend (Angular)
# -------------------------------------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.angular/
frontend/.angular/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# -------------------------------------------------------------------------
# Java / Middleware (Spring Boot & Maven)
# -------------------------------------------------------------------------
target/
middleware/target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# -------------------------------------------------------------------------
# C++ Native Engine (CMake / GCC / Output Binaries)
# -------------------------------------------------------------------------
*.exe
*.o
*.obj
*.dll
*.so
*.dylib
*.lib
*.a
backend-cpp/render_service.exe
backend-cpp/build/
backend-cpp/cmake-build-*/
backend-cpp/out/
backend-cpp/vcpkg_installed/
backend-cpp/.vcpkg/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile.bak

# Generated Report Test Output Files
*.pdf
*.xlsx
*.csv

# -------------------------------------------------------------------------
# Database & Docker Local Data
# -------------------------------------------------------------------------
pgdata/
docker-data/
*.h2.db
*.trace.db

# -------------------------------------------------------------------------
# IDEs, Editors & OS Files
# -------------------------------------------------------------------------
.idea/
*.iml
.vscode/
*.suo
*.user
*.userosv
*.sln.docstates
.DS_Store
Thumbs.db
ehthumbs.db
*.log
*.tmp
*.bak
